{
  "name": "tianwen-runtime-probe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "build": "node scripts/typecheck-packages.mjs",
    "desktop": "pnpm --filter @tianwen/desktop-host start",
    "demo:explicit-correction": "tsx scripts/run-explicit-correction-demo.ts",
    "demo:governed-skill-candidate": "tsx scripts/run-governed-skill-candidate-demo.ts",
    "demo:natural-run-evidence": "tsx scripts/run-natural-run-evidence-demo.ts",
    "demo:paired-skill-evaluation": "tsx scripts/run-paired-skill-evaluation-demo.ts",
    "demo:repeated-outcome": "tsx scripts/run-repeated-outcome-demo.ts",
    "demo:research-preview": "tsx scripts/run-research-preview-demo.ts",
    "demo:shadow-eligibility": "tsx scripts/run-skill-shadow-eligibility-demo.ts",
    "demo:promotion-readiness": "tsx scripts/run-skill-promotion-readiness-demo.ts",
    "install:tianwen": "node scripts/install-tianwen.mjs",
    "typecheck": "node scripts/typecheck-packages.mjs",
    "test:dsh": "vitest run",
    "test:dsh:sandbox": "vitest run tests/dsh-probe/sandbox.e2e.spec.ts",
    "check:dsh-install": "node scripts/check-dsh-install.mjs",
    "check:no-private-dsh-imports": "node scripts/check-dsh-install.mjs --imports",
    "check": "pnpm run check:dsh-install && pnpm run check:no-private-dsh-imports && pnpm run typecheck && pnpm run test:dsh"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "1.0.16",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.1-rc.2",
    "@deepseek-ai/dsh-cordis-host-runner": "0.1.1-rc.2",
    "@deepseek-ai/dsh-goal": "0.1.1-rc.2",
    "@deepseek-ai/dsh-goal-round-driver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-message-feedback": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-reference": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query-sqlite": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-goal": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow-worker-thread": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.1-rc.2",
    "@tianwen/dsh-compat": "workspace:*",
    "@types/node": "22.20.0",
    "chokidar": "4.0.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
