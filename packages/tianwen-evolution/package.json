{
  "name": "@tianwen/evolution",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./run-binding": {
      "types": "./dist/run-binding.d.ts",
      "default": "./dist/run-binding.js"
    },
    "./inspection": {
      "types": "./dist/inspection.d.ts",
      "default": "./dist/inspection.js"
    },
    "./file-mutation-denial": {
      "types": "./dist/conversation-file-mutation-denial.d.ts",
      "default": "./dist/conversation-file-mutation-denial.js"
    },
    "./file-claim-packet": {
      "types": "./dist/conversation-file-claim-packet.d.ts",
      "default": "./dist/conversation-file-claim-packet.js"
    },
    "./learning-intake": {
      "types": "./dist/learning-intake.d.ts",
      "default": "./dist/learning-intake.js"
    },
    "./external-check": {
      "types": "./dist/conversation-external-check.d.ts",
      "default": "./dist/conversation-external-check.js"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
    "@tianwen/dsh-compat": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  }
}
