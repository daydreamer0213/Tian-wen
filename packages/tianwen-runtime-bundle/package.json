{
  "name": "@tianwen/runtime-bundle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "default": "./dist/runtime.js"
    },
    "./smoke": {
      "default": "./dist/smoke.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/runtime.js",
    "dist/smoke.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-goal": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@tianwen/evidence": "workspace:*",
    "@tianwen/runtime": "workspace:*",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "tsc -b && esbuild src/runtime.ts --bundle --platform=node --format=esm --target=node22 --tree-shaking=true --external:@deepseek-ai/* --alias:@tianwen/dsh-compat=@tianwen/dsh-compat/runtime --metafile=dist/runtime.meta.json --outfile=dist/runtime.js && esbuild src/smoke.ts --bundle --platform=node --format=esm --target=node22 --tree-shaking=true --external:@deepseek-ai/* --metafile=dist/smoke.meta.json --outfile=dist/smoke.js",
    "typecheck": "tsc -b --pretty false"
  }
}
