{
  "name": "@tianwen/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./run-binding": {
      "types": "./dist/run-binding.d.ts",
      "default": "./dist/run-binding.js"
    },
    "./research-summary": {
      "types": "./dist/research-summary.d.ts",
      "default": "./dist/research-summary.js"
    }
  },
  "dependencies": {
    "@tianwen/dsh-compat": "workspace:*",
    "@tianwen/evidence": "workspace:*",
    "@tianwen/evolution": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  }
}
