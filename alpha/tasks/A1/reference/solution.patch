+                result.append('"')
+                index += 2
+                continue
+            quoted = not quoted
+            if not quoted:
+                next_index = index + 1
+                while next_index < len(line) and line[next_index].isspace():
+                    next_index += 1
+                if next_index == len(line) or line[next_index] == "|":
+                    index = next_index
+                    continue
+        index += 1
+    return "".join(result)
